{
  "expo": {
    "name": "luna-pdm",
    "slug": "luna-pdm",
    "scheme": "appluna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lunasquad.lunapdm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lunasquad.lunapdm",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa acessar suas fotos para anexar o laudo e a foto do aluno.",
          "cameraPermission": "O aplicativo precisa acessar a câmera para tirar a foto do laudo e do aluno."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "O Luna usa o NFC para ler a tag de convite da sua turma."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c0268ae1-6ce7-42bb-894b-bacfddf028a1"
      }
    }
  }
}
